{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "stuff's own windows: the main windows and Quick Entry.",
  "windows": ["main", "main-*", "quick"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "things:*" }]
    },
    "opener:allow-reveal-item-in-dir",
    "allow-key-status",
    "allow-generate-key",
    "allow-import-key",
    "allow-seal-object",
    "allow-open-object",
    "allow-store-load",
    "allow-store-save",
    "allow-store-dirty",
    "allow-store-clean",
    "allow-meta-get",
    "allow-meta-set",
    "allow-things-read",
    "allow-text-read",
    "allow-text-write",
    "allow-themes-load",
    "allow-folder-list",
    "allow-folder-stat",
    "allow-folder-read",
    "allow-folder-write",
    "allow-new-window",
    "allow-quick-entry"
  ]
}
