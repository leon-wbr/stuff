    "checkbox": "#3d6b5a",
    "checkbox-border": "#85847f73",
    "ring": "#3d6b5a",
    "accent": "#e9eee9",
    "today": "#d99a2b",
    "evening": "#6f74b8",
    "inbox": "#0084d1",
    "upcoming": "#ec003f",
    "someday": "#a89a6a",
