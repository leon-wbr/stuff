  "vars": {
    "font-ui": "-apple-system, BlinkMacSystemFont, \"Inter\", ui-sans-serif, sans-serif",
    "font-title": "var(--font-ui)",
    "text-size": "13px",
    "text-meta-size": "11px",
    "text-title-size": "24px",
    "weight-body": "400",
    "weight-heading": "600",
    "weight-title": "600",
    "row-height": "30px",
    "spacing": "4px",
    "sidebar-width": "232px",
    "radius": "8px",
    "checkbox-size": "15px",
    "checkbox-radius": "4px",
    "editor-shadow": "0 1px 4px rgb(0 0 0 / 0.08), 0 0 0 1px var(--border)",
    "fab-shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  }
}
