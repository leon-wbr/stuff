{
  "$schema": "./theme.schema.json",
  "name": "Persimmon",
  "light": {
    "background": "#fafafa",
    "foreground": "#1c1917",
    "muted-foreground": "#625c58",
    "sidebar": "#f1f1f1",
    "sidebar-accent": "#e4e4e4",
    "selected": "#fde4d6",
    "muted": "#efefef",
    "card": "#ffffff",
    "popover": "#ffffff",
    "border": "#00000017",
    "primary": "#c23b14",
    "primary-foreground": "#ffffff",
    "checkbox": "#c23b14",
    "checkbox-border": "#1c19174d",
    "ring": "#c23b14",
    "accent": "#fdeee6",
    "today": "#a86a00",
    "evening": "#5b4fc4",
    "inbox": "#3f6fb5",
    "upcoming": "#c23b14",
    "someday": "#8a7650",
    "logbook": "#3f7f5f",
    "deadline": "#c23b14",
    "destructive": "#b42318"
  },
  "dark": {
    "background": "#19171a",
    "foreground": "#f3eeea",
    "muted-foreground": "#a8a19c",
    "sidebar": "#201d20",
    "sidebar-accent": "#332c2b",
    "selected": "#452a20",
    "muted": "#262326",
    "card": "#221f22",
    "popover": "#2a2629",
    "border": "#ffffff17",
    "primary": "#ff7a4d",
    "primary-foreground": "#2a0d02",
    "checkbox": "#ff7a4d",
    "checkbox-border": "#f3eeea59",
    "ring": "#ff7a4d",
    "accent": "#3a2620",
    "today": "#ffbe3d",
    "evening": "#a99cff",
    "inbox": "#8fb4ff",
    "upcoming": "#ff7a4d",
    "someday": "#d6c08f",
    "logbook": "#7fd1a5",
    "deadline": "#ff7a4d",
    "destructive": "#ff6b5b"
  },
  "vars": {
    "font-ui": "ui-rounded, \"SF Pro Rounded\", -apple-system, sans-serif",
    "font-title": "var(--font-ui)",
    "text-size": "13px",
    "text-meta-size": "11px",
    "text-title-size": "30px",
    "weight-body": "400",
    "weight-heading": "600",
    "weight-title": "700",
    "row-height": "34px",
    "spacing": "4px",
    "sidebar-width": "244px",
    "radius": "12px",
    "checkbox-size": "17px",
    "checkbox-radius": "50%",
    "editor-shadow": "0 14px 32px -10px rgb(0 0 0 / 0.28), 0 0 0 1px var(--border)",
    "fab-shadow": "0 16px 30px -8px rgb(0 0 0 / 0.35)"
  }
}
