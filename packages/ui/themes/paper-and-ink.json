    "muted-foreground": "#655e52",
    "sidebar": "#efe9dc",
    "sidebar-accent": "#e2d9c6",
    "selected": "#e6dcc5",
    "muted": "#efe8da",
    "card": "#fffdf8",
    "popover": "#fffdf8",
    "border": "#3a2f1a1f",
    "primary": "#1f3a5f",
    "primary-foreground": "#ffffff",
    "checkbox": "#1f3a5f",
    "checkbox-border": "#22201c66",
    "ring": "#1f3a5f",
    "accent": "#ebe3d1",
    "today": "#a26a00",
    "evening": "#4a4f8c",
    "inbox": "#2f5d87",
    "upcoming": "#a33b3b",
    "someday": "#7d6b3f",
    "logbook": "#4f6b45",
    "deadline": "#a8322a",
    "destructive": "#a8322a"
