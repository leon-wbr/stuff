    "row-height": "32px",
    "spacing": "4px",
    "sidebar-width": "232px",
    "radius": "8px",
    "checkbox-size": "15px",
    "checkbox-radius": "4px",
    "editor-shadow": "0 4px 16px rgb(0 0 0 / 0.08), 0 0 0 1px var(--border)",
    "fab-shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  }
