    "sidebar-accent": "#363026",
    "selected": "#3a3225",
    "muted": "#2a261f",
    "card": "#29251e",
    "popover": "#2e2a22",
    "border": "#ece4d41a",
    "primary": "#9db8de",
    "primary-foreground": "#13202f",
