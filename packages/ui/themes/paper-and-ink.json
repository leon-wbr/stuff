    "upcoming": "#e0938a",
    "someday": "#cdb98a",
    "logbook": "#a9c79a",
    "deadline": "#e8806f",
    "destructive": "#e8806f"
  },
  "vars": {
    "font-ui": "-apple-system, BlinkMacSystemFont, \"Inter\", ui-sans-serif, sans-serif",
    "font-title": "ui-serif, \"New York\", Georgia, serif",
    "text-size": "13px",
    "text-meta-size": "11px",
    "text-title-size": "28px",
    "weight-body": "400",
    "weight-heading": "600",
