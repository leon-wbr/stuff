{
  "$schema": "./theme.schema.json",
  "name": "Sage",
  "light": {
    "background": "#fbfbfa",
    "foreground": "#1f2023",
    "muted-foreground": "#66655f",
    "sidebar": "#f2f4f2",
    "sidebar-accent": "#e1e7e2",
    "selected": "#dbe8e0",
    "muted": "#eff1ee",
    "card": "#ffffff",
    "popover": "#ffffff",
    "border": "#0000001a",
    "primary": "#33604f",
    "primary-foreground": "#ffffff",
    "checkbox": "#33604f",
    "checkbox-border": "#1f202359",
    "ring": "#33604f",
    "accent": "#e6ede8",
    "today": "#b07a12",
    "evening": "#5a5fa8",
    "inbox": "#3a6f9c",
    "upcoming": "#b5475b",
    "someday": "#857849",
    "logbook": "#4f7a63",
    "deadline": "#b83a30",
    "destructive": "#b83a30"
  },
  "dark": {
    "background": "#1b1c1e",
    "foreground": "#e8e7e3",
    "muted-foreground": "#9c9b96",
    "sidebar": "#212224",
    "sidebar-accent": "#2f332f",
    "selected": "#2c3b33",
    "muted": "#27282b",
    "card": "#242528",
    "popover": "#2a2b30",
    "border": "#ffffff14",
    "primary": "#86b9a3",
    "primary-foreground": "#10201a",
    "checkbox": "#86b9a3",
    "checkbox-border": "#e8e7e35c",
    "ring": "#86b9a3",
    "accent": "#2c3531",
    "today": "#e8b450",
    "evening": "#a3a7e6",
    "inbox": "#7fb0dd",
    "upcoming": "#e88a9b",
    "someday": "#c9ba85",
    "logbook": "#8cc4a5",
    "deadline": "#ef7a6e",
    "destructive": "#ef7a6e"
  },
  "vars": {
    "font-ui": "-apple-system, BlinkMacSystemFont, \"Inter\", ui-sans-serif, sans-serif",
    "font-title": "var(--font-ui)",
    "text-size": "13px",
    "text-meta-size": "12px",
    "text-title-size": "26px",
    "weight-body": "400",
    "weight-heading": "600",
    "weight-title": "650",
    "row-height": "32px",
    "spacing": "4px",
    "sidebar-width": "232px",
    "radius": "8px",
    "checkbox-size": "16px",
    "checkbox-radius": "6px",
    "editor-shadow": "0 4px 16px rgb(0 0 0 / 0.08), 0 0 0 1px var(--border)",
    "fab-shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  }
}
