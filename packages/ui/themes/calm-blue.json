{
  "$schema": "./theme.schema.json",
  "name": "Calm Blue",
  "light": {
    "background": "#ffffff",
    "foreground": "#1d1d1f",
    "muted-foreground": "#6b6b70",
    "sidebar": "#f4f5f7",
    "sidebar-accent": "#e3e6eb",
    "selected": "#dce8fc",
    "muted": "#f1f2f4",
    "card": "#ffffff",
    "popover": "#ffffff",
    "border": "#0000001a",
    "primary": "#2f6fdb",
    "primary-foreground": "#ffffff",
    "checkbox": "#2f6fdb",
    "checkbox-border": "#1d1d1f4d",
    "ring": "#2f6fdb",
    "accent": "#edf2fb",
    "today": "#a87a00",
    "evening": "#4f62c9",
    "inbox": "#2f6fdb",
    "upcoming": "#d6304f",
    "someday": "#94824c",
    "logbook": "#36945a",
    "deadline": "#d6304f",
    "destructive": "#d6304f"
  },
  "dark": {
    "background": "#1e1f22",
    "foreground": "#ececee",
    "muted-foreground": "#9b9ba0",
    "sidebar": "#26272b",
    "sidebar-accent": "#34363c",
    "selected": "#23385c",
    "muted": "#2a2b2f",
    "card": "#26272b",
    "popover": "#2c2d31",
    "border": "#ffffff17",
    "primary": "#5b9bff",
    "primary-foreground": "#0b1b36",
    "checkbox": "#5b9bff",
    "checkbox-border": "#ececee59",
    "ring": "#5b9bff",
    "accent": "#26324a",
    "today": "#f5c84b",
    "evening": "#8f9cf0",
    "inbox": "#5b9bff",
    "upcoming": "#ff6b81",
    "someday": "#cbb97f",
    "logbook": "#5fce88",
    "deadline": "#ff6b6b",
    "destructive": "#ff6b6b"
  },
  "vars": {
    "font-ui": "-apple-system, BlinkMacSystemFont, \"Inter\", ui-sans-serif, sans-serif",
    "font-title": "var(--font-ui)",
    "text-size": "13px",
    "text-meta-size": "11px",
    "text-title-size": "26px",
    "weight-body": "400",
    "weight-heading": "600",
    "weight-title": "700",
    "row-height": "32px",
    "spacing": "4px",
    "sidebar-width": "240px",
    "radius": "8px",
    "checkbox-size": "15px",
    "checkbox-radius": "4px",
    "editor-shadow": "0 14px 32px -10px rgb(0 0 0 / 0.28), 0 0 0 1px var(--border)",
    "fab-shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  }
}
