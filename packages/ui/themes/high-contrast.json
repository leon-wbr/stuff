{
  "$schema": "./theme.schema.json",
  "name": "High Contrast",
  "light": {
    "background": "#ffffff",
    "foreground": "#000000",
    "muted-foreground": "#4d4d4d",
    "sidebar": "#f0f0f0",
    "sidebar-accent": "#d6d6d6",
    "selected": "#cfe0ff",
    "muted": "#ebebeb",
    "card": "#ffffff",
    "popover": "#ffffff",
    "border": "#00000040",
    "primary": "#0040c1",
    "primary-foreground": "#ffffff",
    "checkbox": "#0040c1",
    "checkbox-border": "#000000a6",
    "ring": "#0040c1",
    "accent": "#e0e8ff",
    "today": "#8a5a00",
    "evening": "#3a2fa0",
    "inbox": "#00509e",
    "upcoming": "#b0002a",
    "someday": "#6b5a1e",
    "logbook": "#006637",
    "deadline": "#b0001e",
    "destructive": "#b0001e"
  },
  "dark": {
    "background": "#000000",
    "foreground": "#ffffff",
    "muted-foreground": "#bdbdbd",
    "sidebar": "#111111",
    "sidebar-accent": "#333333",
    "selected": "#1a3366",
    "muted": "#1c1c1c",
    "card": "#121212",
    "popover": "#1a1a1a",
    "border": "#ffffff4d",
    "primary": "#7fb0ff",
    "primary-foreground": "#000000",
    "checkbox": "#7fb0ff",
    "checkbox-border": "#ffffffb3",
    "ring": "#7fb0ff",
    "accent": "#1a2a4a",
    "today": "#ffd23f",
    "evening": "#b8b3ff",
    "inbox": "#7fb0ff",
    "upcoming": "#ff7a90",
    "someday": "#e6d38f",
    "logbook": "#5ee08f",
    "deadline": "#ff6b6b",
    "destructive": "#ff6b6b"
  },
  "vars": {
    "font-ui": "-apple-system, BlinkMacSystemFont, \"Inter\", ui-sans-serif, sans-serif",
    "font-title": "var(--font-ui)",
    "text-size": "14px",
    "text-meta-size": "12px",
    "text-title-size": "24px",
    "weight-body": "400",
    "weight-heading": "600",
    "weight-title": "700",
    "row-height": "32px",
    "spacing": "4px",
    "sidebar-width": "232px",
    "radius": "8px",
    "checkbox-size": "17px",
    "checkbox-radius": "1px",
    "editor-shadow": "0 0 0 1px var(--border)",
    "fab-shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  }
}
